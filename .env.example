# Public Supabase browser configuration (safe to expose; still protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only waitlist integration. Never prefix the service-role key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WAITLIST_TABLE=

# Server-side PostHog capture endpoint.
POSTHOG_API_KEY=
POSTHOG_HOST=

# The canonical public origin. The amoCRM redirect_uri is built from it, and the
# customer pastes that exact string into their integration — so it must NOT be
# derived from the incoming request (a preview URL or a bare apex would produce a
# different value and break the token exchange). Defaults to
# https://www.liveassist.tech. Set http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=

# Application-level encryption for CRM secrets (amoCRM client_secret, access and
# refresh tokens) in public.crm_connection_secrets. SERVER ONLY — never prefix
# with NEXT_PUBLIC_.
#
# Must decode to exactly 32 bytes. Generate one with:  openssl rand -base64 32
#
# There is deliberately no default and no fallback: a missing key is a loud
# failure at the call site, not a weak cipher. Rotating it makes existing stored
# secrets undecryptable, so customers would have to reconnect their CRM — teach
# lib/crm/crypto.ts a second version prefix instead of swapping this in place.
CRM_SECRETS_ENCRYPTION_KEY=
